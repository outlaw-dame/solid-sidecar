{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://solid-sidecar.local/contracts/fixture_bundle_manifest.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "bundle_hash", "snapshot_hashes", "rollup_hash", "manifest_hash", "fixture_only"],
  "properties": {
    "schema_version": {"type": "string", "const": "policy.fixture.bundle_manifest.v1"},
    "bundle_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "snapshot_hashes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-f0-9]{64}$"}},
    "rollup_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "manifest_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "fixture_only": {"type": "boolean", "const": true}
  }
}
