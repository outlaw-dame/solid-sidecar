{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://solid-sidecar.local/contracts/policy_semantics_fixture.schema.json",
  "title": "Solid Sidecar Policy Semantics Fixture Suite",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "cases"],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "policy.semantics.fixtures.v1"
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/case"
      }
    }
  },
  "$defs": {
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "family", "request", "expected_decision", "expected_reason_code"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[^\\u0000-\\u001F\\u007F]+$"
        },
        "family": {
          "type": "string",
          "enum": ["wac", "acp", "sai"]
        },
        "description": {
          "type": "string",
          "maxLength": 512,
          "pattern": "^[^\\u0000-\\u001F\\u007F]*$"
        },
        "request": {
          "$ref": "authz_request.schema.json"
        },
        "policy_documents": {
          "type": "array",
          "items": {
            "$ref": "policy_input.schema.json#/$defs/policy_document"
          }
        },
        "expected_decision": {
          "type": "string",
          "enum": ["allow", "deny", "abstain"]
        },
        "expected_reason_code": {
          "type": "string",
          "enum": ["policy_allow", "policy_deny", "kernel_abstain_shadow_mode", "policy_not_loaded"]
        },
        "expected_modes": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": ["read", "append", "write", "control"]
          }
        }
      }
    }
  }
}
