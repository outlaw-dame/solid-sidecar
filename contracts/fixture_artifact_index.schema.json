{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://solid-sidecar.local/contracts/fixture_artifact_index.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "records", "fixture_only", "catalog_hash"],
  "properties": {
    "schema_version": {"type": "string", "const": "policy.fixture.artifact_catalog.v1"},
    "records": {"type": "array", "minItems": 1},
    "fixture_only": {"type": "boolean", "const": true},
    "catalog_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
