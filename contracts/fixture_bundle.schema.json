{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://solid-sidecar.local/contracts/fixture_bundle.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "snapshots", "summary", "fixture_only", "bundle_hash"],
  "properties": {
    "schema_version": {"type": "string", "const": "policy.fixture.bundle.v1"},
    "snapshots": {"type": "array", "minItems": 1, "items": {"$ref": "fixture_snapshot.schema.json"}},
    "summary": {"$ref": "fixture_rollup.schema.json"},
    "fixture_only": {"type": "boolean", "const": true},
    "bundle_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
