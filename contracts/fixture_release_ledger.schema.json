{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://solid-sidecar.local/contracts/fixture_release_ledger.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "records", "fixture_only", "ledger_hash"],
  "properties": {
    "schema_version": {"type": "string", "const": "policy.fixture.release_ledger.v1"},
    "records": {"type": "array", "minItems": 1, "items": {"$ref": "fixture_release_record.schema.json"}},
    "fixture_only": {"type": "boolean", "const": true},
    "ledger_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
