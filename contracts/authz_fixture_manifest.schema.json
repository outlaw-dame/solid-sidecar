{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://solid-sidecar.local/contracts/authz_fixture_manifest.schema.json",
  "title": "Solid Sidecar Authorization Fixture Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "cases"],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "authz.fixture-manifest.v1"
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "request", "decision", "valid_request"],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[ -~]+$"
          },
          "request": {
            "type": "string",
            "pattern": "^authz_request\\.[A-Za-z0-9_-]+\\.json$"
          },
          "decision": {
            "type": "string",
            "pattern": "^authz_decision\\.[A-Za-z0-9_-]+\\.json$"
          },
          "valid_request": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
