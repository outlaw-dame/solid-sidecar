FROM golang:1.22-alpine AS build
WORKDIR /src
COPY go.mod ./
COPY cmd ./cmd
COPY internal ./internal
RUN go test ./...
RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build -trimpath -ldflags="-s -w" -o /out/solid-sidecar ./cmd/solid-sidecar

FROM alpine:3.20
RUN adduser -D -H -u 10001 sidecar
COPY --from=build /out/solid-sidecar /usr/local/bin/solid-sidecar
USER sidecar
EXPOSE 8443
ENTRYPOINT ["/usr/local/bin/solid-sidecar"]
