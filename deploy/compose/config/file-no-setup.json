{
  "serverUri": "http://localhost:3000/",
  "rootFilePath": "/data/",
  "enableCors": true,
  "corsAllowOrigin": ["*"],
  "corsAllowMethods": ["GET", "HEAD", "OPTIONS", "POST", "PUT", "PATCH", "DELETE"],
  "corsAllowHeaders": ["*"],
  "corsExposeHeaders": ["*"],
  "corsMaxAge": 86400,
  "multiuser": true,
  "sparqlEndpoint": {
    "enabled": false
  },
  "webid": {
    "enabled": true
  }
}
