{
  "dashboard": {
    "id": null,
    "uid": "solid-sidecar-overview",
    "title": "Solid Sidecar - Overview",
    "tags": ["solid", "sidecar", "overview"],
    "timezone": "browser",
    "schemaVersion": 30,
    "version": 1,
    "refresh": "30s",
    "panels": [
      {
        "type": "stat",
        "title": "Requests per Second",
        "gridPos": {"h": 4, "w": 6, "x": 0, "y": 0},
        "fieldConfig": {
          "defaults": {
            "mappings": [],
            "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}]},
            "unit": "reqps"
          },
          "overrides": []
        },
        "targets": [
          {
            "expr": "rate(solid_sidecar_http_requests_total[1m])",
            "legendFormat": "{{method}} {{status_code}}",
            "refId": "A"
          }
        ]
      },
      {
        "type": "stat",
        "title": "Active Sessions",
        "gridPos": {"h": 4, "w": 6, "x": 6, "y": 0},
        "fieldConfig": {
          "defaults": {
            "mappings": [],
            "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}]},
            "unit": "short"
          },
          "overrides": []
        },
        "targets": [
          {
            "expr": "sum(solid_sidecar_session_active_sessions)",
            "refId": "A"
          }
        ]
      },
      {
        "type": "stat",
        "title": "Cache Hit Rate",
        "gridPos": {"h": 4, "w": 6, "x": 12, "y": 0},
        "fieldConfig": {
          "defaults": {
            "mappings": [],
            "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}]},
            "unit": "percent"
          },
          "overrides": []
        },
        "targets": [
          {
            "expr": "avg(solid_sidecar_cache_hit_rate) * 100",
            "refId": "A"
          }
        ]
      },
      {
        "type": "stat",
        "title": "Error Rate",
        "gridPos": {"h": 4, "w": 6, "x": 18, "y": 0},
        "fieldConfig": {
          "defaults": {
            "mappings": [],
            "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": 0.05}]},
            "unit": "percent"
          },
          "overrides": []
        },
        "targets": [
          {
            "expr": "rate(solid_sidecar_http_requests_total{status_code=~"5.."}[1m]) / rate(solid_sidecar_http_requests_total[1m]) * 100",
            "refId": "A"
          }
        ]
      },
      {
        "type": "graph",
        "title": "Request Rate by Method",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 4},
        "fieldConfig": {
          "defaults": {
            "custom": {"drawStyle": "line", "lineInterpolation": "smooth", "barAlignment": 0, "lineWidth": 2, "fillOpacity": 10, "gradientMode": "none", "spanNulls": false, "showPoints": "never", "pointSize": 5, "stacking": {"mode": "none", "group": "A"}, "axisPlacement": "auto", "axisLabel": "", "axisColorMode": "text", "scaleDistribution": {"type": "linear"}, "axisCenteredZero": false, "hideFrom": {"tooltip": false, "viz": false, "legend": false}}
          },
          "mappings": [],
          "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}]},
          "unit": "reqps"
        },
        "overrides": []
      },
        "targets": [
          {
            "expr": "rate(solid_sidecar_http_requests_total[1m])",
            "legendFormat": "{{method}}",
            "refId": "A"
          }
        ]
      },
      {
        "type": "graph",
        "title": "Request Latency",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 4},
        "fieldConfig": {
          "defaults": {
            "custom": {"drawStyle": "line", "lineInterpolation": "smooth", "barAlignment": 0, "lineWidth": 2, "fillOpacity": 10, "gradientMode": "none", "spanNulls": false, "showPoints": "never", "pointSize": 5, "stacking": {"mode": "none", "group": "A"}, "axisPlacement": "auto", "axisLabel": "", "axisColorMode": "text", "scaleDistribution": {"type": "linear"}, "axisCenteredZero": false, "hideFrom": {"tooltip": false, "viz": false, "legend": false}}
          },
          "mappings": [],
          "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "orange", "value": 0.5}, {"color": "red", "value": 1.0}]},
          "unit": "s"
        },
        "overrides": []
      },
        "targets": [
          {
            "expr": "histogram_quantile(0.95, sum(rate(solid_sidecar_http_request_duration_seconds_bucket[1m])) by (le))",
            "legendFormat": "p95",
            "refId": "A"
          },
          {
            "expr": "histogram_quantile(0.99, sum(rate(solid_sidecar_http_request_duration_seconds_bucket[1m])) by (le))",
            "legendFormat": "p99",
            "refId": "B"
          },
          {
            "expr": "avg(rate(solid_sidecar_http_request_duration_seconds_sum[1m]) / rate(solid_sidecar_http_request_duration_seconds_count[1m]))",
            "legendFormat": "avg",
            "refId": "C"
          }
        ]
      },
      {
        "type": "graph",
        "title": "Authorization Decisions",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 12},
        "fieldConfig": {
          "defaults": {
            "custom": {"drawStyle": "bars", "lineInterpolation": "smooth", "barAlignment": 0, "lineWidth": 2, "fillOpacity": 80, "gradientMode": "none", "spanNulls": false, "showPoints": "never", "pointSize": 5, "stacking": {"mode": "none", "group": "A"}, "axisPlacement": "auto", "axisLabel": "", "axisColorMode": "text", "scaleDistribution": {"type": "linear"}, "axisCenteredZero": false, "hideFrom": {"tooltip": false, "viz": false, "legend": false}}
          },
          "mappings": [],
          "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}]},
          "unit": "short"
        },
        "overrides": []
      },
        "targets": [
          {
            "expr": "rate(solid_sidecar_authz_decisions_total[1m])",
            "legendFormat": "{{decision}} ({{policy_type}})",
            "refId": "A"
          }
        ]
      },
      {
        "type": "graph",
        "title": "Cache Operations",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 12},
        "fieldConfig": {
          "defaults": {
            "custom": {"drawStyle": "bars", "lineInterpolation": "smooth", "barAlignment": 0, "lineWidth": 2, "fillOpacity": 80, "gradientMode": "none", "spanNulls": false, "showPoints": "never", "pointSize": 5, "stacking": {"mode": "none", "group": "A"}, "axisPlacement": "auto", "axisLabel": "", "axisColorMode": "text", "scaleDistribution": {"type": "linear"}, "axisCenteredZero": false, "hideFrom": {"tooltip": false, "viz": false, "legend": false}}
          },
          "mappings": [],
          "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}]},
          "unit": "short"
        },
        "overrides": []
      },
        "targets": [
          {
            "expr": "rate(solid_sidecar_cache_hits_total[1m])",
            "legendFormat": "Hits ({{cache_type}})",
            "refId": "A"
          },
          {
            "expr": "rate(solid_sidecar_cache_requests_total[1m])",
            "legendFormat": "Requests ({{cache_type}})",
            "refId": "B"
          }
        ]
      },
      {
        "type": "graph",
        "title": "Mismatch Rate",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 20},
        "fieldConfig": {
          "defaults": {
            "custom": {"drawStyle": "line", "lineInterpolation": "smooth", "barAlignment": 0, "lineWidth": 2, "fillOpacity": 10, "gradientMode": "none", "spanNulls": false, "showPoints": "never", "pointSize": 5, "stacking": {"mode": "none", "group": "A"}, "axisPlacement": "auto", "axisLabel": "", "axisColorMode": "text", "scaleDistribution": {"type": "linear"}, "axisCenteredZero": false, "hideFrom": {"tooltip": false, "viz": false, "legend": false}}
          },
          "mappings": [],
          "thresholds": {"mode": "absolute", "steps": [{"color": "orange", "value": 0.01}, {"color": "red", "value": 0.05}]},
          "unit": "percent"
        },
        "overrides": []
      },
        "targets": [
          {
            "expr": "rate(solid_sidecar_authz_mismatches_total[1m]) / rate(solid_sidecar_authz_decisions_total[1m]) * 100",
            "legendFormat": "{{mismatch_type}} ({{policy_type}})",
            "refId": "A"
          }
        ]
      },
      {
        "type": "graph",
        "title": "Memory Usage",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 20},
        "fieldConfig": {
          "defaults": {
            "custom": {"drawStyle": "line", "lineInterpolation": "smooth", "barAlignment": 0, "lineWidth": 2, "fillOpacity": 10, "gradientMode": "none", "spanNulls": false, "showPoints": "never", "pointSize": 5, "stacking": {"mode": "none", "group": "A"}, "axisPlacement": "auto", "axisLabel": "", "axisColorMode": "text", "scaleDistribution": {"type": "linear"}, "axisCenteredZero": false, "hideFrom": {"tooltip": false, "viz": false, "legend": false}}
          },
          "mappings": [],
          "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "orange", "value": 1000000000}, {"color": "red", "value": 2000000000}]},
          "unit": "bytes"
        },
        "overrides": []
      },
        "targets": [
          {
            "expr": "solid_sidecar_runtime_memory_usage_bytes{memory_type="heap"}",
            "legendFormat": "Heap",
            "refId": "A"
          },
          {
            "expr": "solid_sidecar_runtime_memory_usage_bytes{memory_type="total"}",
            "legendFormat": "Total",
            "refId": "B"
          }
        ]
      }
    ],
    "templating": {
      "list": []
    },
    "annotations": {
      "list": []
    },
    "refresh": "30s",
    "schemaVersion": 30,
    "style": "dark",
    "tags": ["solid", "sidecar", "monitoring"],
    "time": {
      "from": "now-1h",
      "to": "now"
    },
    "timepicker": {
      "refresh_intervals": ["5s", "10s", "30s", "1m", "5m", "15m", "30m", "1h", "2h", "1d"],
      "time_options": ["5m", "15m", "1h", "6h", "12h", "24h", "2d", "7d", "30d"]
    },
    "timezone": "",
    "title": "Solid Sidecar - Overview",
    "uid": "solid-sidecar-overview",
    "version": 1,
    "weekStart": ""
  },
  "folderId": 0,
