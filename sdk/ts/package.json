{
  "name": "@outlaw-dame/solid-sidecar-client",
  "version": "1.0.0-beta.1",
  "description": "Solid Sidecar TypeScript/JavaScript client SDK",
  "author": "outlaw-dame contributors",
  "license": "MIT",
  "keywords": [
    "solid",
    "sidecar",
    "dpop",
    "oidc",
    "rdf",
    "wac",
    "acp",
    "notifications"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "clean": "rm -rf dist coverage",
    "build": "npm run clean && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src/**/*.ts test/**/*.ts",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage --runInBand",
    "pack:check": "npm pack --dry-run",
    "prepack": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "cross-fetch": "^4.0.0",
    "jose": "^5.0.0",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.11",
    "@types/node": "^20.10.5",
    "@types/uuid": "^9.0.7",
    "eslint": "^8.56.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/outlaw-dame/solid-sidecar.git",
    "directory": "sdk/ts"
  },
  "bugs": {
    "url": "https://github.com/outlaw-dame/solid-sidecar/issues"
  },
  "homepage": "https://github.com/outlaw-dame/solid-sidecar#readme"
}
